# Clerk Authentication Configuration
# Find this in your Clerk Dashboard -> API Keys
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# Supabase Database Configuration
# Find these in your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Enable after the protected sales migration passes staging checks.
VITE_PROTECTED_SALES_ENABLED=false

# Public site origin for social link previews outside Vercel (no trailing slash)
# SITE_URL=https://your-domain.example
